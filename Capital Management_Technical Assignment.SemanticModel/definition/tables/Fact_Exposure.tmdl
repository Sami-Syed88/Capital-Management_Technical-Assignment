	partition Fact_Exposure = m
		mode: import
		queryGroup: 03_Reporting_Model
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Users\samis\Downloads\Nordea\Fact_Exposure.csv"),[Delimiter=",", Columns=10, Encoding=1252, QuoteStyle=QuoteStyle.None]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"ExposureID", type text}, {"ReportMonth", type date}, {"CounterpartyID", type text}, {"CountryCode", type text}, {"SegmentCode", type text}, {"Currency", type text}, {"ExposureEUR", Int64.Type}, {"RWA", Int64.Type}, {"CapitalRequirement", Int64.Type}, {"ScenarioCode", type text}}),
				    #"Trimmed Text" = Table.TransformColumns(#"Changed Type",{{"ExposureID", Text.Trim, type text}, {"CounterpartyID", Text.Trim, type text}, {"CountryCode", Text.Trim, type text}, {"SegmentCode", Text.Trim, type text}, {"Currency", Text.Trim, type text}, {"ScenarioCode", Text.Trim, type text}}),
				    #"Uppercased Text" = Table.TransformColumns(#"Trimmed Text",{{"ExposureID", Text.Upper, type text}, {"CounterpartyID", Text.Upper, type text}, {"CountryCode", Text.Upper, type text}, {"Currency", Text.Upper, type text}, {"SegmentCode", Text.Upper, type text}}),
				    #"Changed Type1" = Table.TransformColumnTypes(#"Uppercased Text",{{"ExposureEUR", type text}}),
				    Remove_Exposure_Thousands_Separators = Table.ReplaceValue(#"Changed Type1",",","",Replacer.ReplaceText,{"ExposureEUR"}),
				    #"Changed Type2" = Table.TransformColumnTypes(Remove_Exposure_Thousands_Separators,{{"ExposureEUR", Currency.Type}, {"RWA", Currency.Type}, {"CapitalRequirement", Currency.Type}, {"ReportMonth", type date}}),
				    // Removed duplicate exposure records based on ExposureID to prevent double counting in financial reporting.
				    Remove_Duplicate_ExposureIDs = Table.Distinct(#"Changed Type2", {"ExposureID"}),
				    // Checks ExposureEUR, RWA, and CapitalRequirement for null values and flags all missing fields.
				    #"Added DQ_status" = Table.AddColumn(Remove_Duplicate_ExposureIDs, "DQ_Status", each let
				            Issues = List.RemoveNulls({
				                if [ExposureEUR] = null then "Missing Exposure" else null,
				                if [RWA] = null then "Missing RWA" else null,
				                if [CapitalRequirement] = null then "Missing Capital" else null
				            })
				        in
				            if List.IsEmpty(Issues) then "OK"
				            else Text.Combine(Issues, ", ")),
				    #"Trimmed Text1" = Table.TransformColumns(#"Added DQ_status",{{"ExposureID", Text.Trim, type text}}),
				    #"Changed Type3" = Table.TransformColumnTypes(#"Trimmed Text1",{{"DQ_Status", type text}})
				in
				    #"Changed Type3"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

