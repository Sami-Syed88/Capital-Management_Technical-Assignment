table Fact_Exposure
	lineageTag: dde2f530-4702-4d0f-a738-fec057449c59

	measure 'DQ Status Highlight' =
			
			IF(
			    SELECTEDVALUE(Fact_Exposure[DQ_Status]) = "Missing RWA",
			    "#FFCCCC",
			    "#FFFFFF"
			)
